<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_goreecloud_keyboard"
        android:roundIcon="@drawable/ic_goreecloud_keyboard"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoreeCloudKeyboard">

        <activity
            android:name=".KeyboardSettingsActivity"
            android:exported="true"
            android:label="@string/keyboard_settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".KeyboardPortablePreferencesActivity"
            android:exported="true"
            android:label="@string/portable_preferences_title" />

        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
