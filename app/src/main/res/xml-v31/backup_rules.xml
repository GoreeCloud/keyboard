<?xml version="1.0" encoding="utf-8"?>
<!-- Defense in depth: allowBackup=false does not block every Android
     device-to-device transfer path. Do not export typing-related app data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
